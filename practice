<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jax's Practice Portfolio</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background: #f4f4f4;
            color: #333;
        }
        header {
            background: #1a73e8;
            color: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }
        .card {
            background: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        button {
            background: #1a73e8;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background: #1557b0;
        }
    </style>
</head>
<body>
    <header>
        <h1>Jax Searles</h1>
        <p>Transitioning to Software Engineering | Finance Domain Expert</p>
    </header>

    <div class="card">
        <h2>About Me</h2>
        <p>15+ years in regulated financial services. Currently building Python and cloud skills to become a Software Engineer.</p>
    </div>

    <div class="card">
        <h2>Skills I'm Building</h2>
        <ul id="skills">
            <li>Python</li>
            <li>SQL</li>
            <li>Azure</li>
        </ul>
        <button onclick="addSkill()">Add a New Skill</button>
    </div>

    <script>
        function addSkill() {
            const skill = prompt("Enter a new skill:");
            if (skill) {
                const li = document.createElement("li");
                li.textContent = skill;
                document.getElementById("skills").appendChild(li);
            }
        }
    </script>
</body>
</html>
